  m_Script: {fileID: 11500000, guid: 0cb74f1869393c446b111ecd5cc4f2b5, type: 3}
  m_Name: SumorDialouge1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Sumor
    text: "Buraya kadar gelebilmene \u015Fa\u015F\u0131rd\u0131m. Hemen rahatlamaya
      ba\u015Flama bundan sonra i\u015Fin \xE7ok daha zor olacak. "
  - speakerName: Sumor
    text: "G\xFC\xE7lerinle kendine yollar olu\u015Fturdu\u011Funu g\xF6r\xFCyorum
      ama hepsi \xE7ok yetersiz. Daha g\xFC\xE7lerini bile tam kullanam\u0131yorsun.\n"
  - speakerName: Sumor
    text: "senin Winter'a ula\u015Famayaca\u011F\u0131na dair Lencten  ile bahse
      bile girdim.\nBahsi kazansam da kaybetsem de sen gazab\u0131mdan ka\xE7amayacaks\u0131n. "
